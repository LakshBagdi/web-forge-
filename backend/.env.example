# --- Core ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://vs:vs@localhost:5432/vulnsight
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173

# --- Scope & safety ---
# Hostnames that are pre-authorized test targets (e.g. your deployed demo lab)
LAB_TARGETS=localhost:4100
# NEVER enable in production. Allows scanning private/loopback IPs for local dev only.
ALLOW_PRIVATE_TARGETS=false
SCANS_PER_HOUR_PER_USER=12
MAX_CONCURRENT_SCANS=3
SCAN_REQUEST_BUDGET=300
SCAN_TIMEOUT_MS=180000

# --- AI remediation (pick one; falls back to built-in knowledge base if unset) ---
LLM_PROVIDER=gemini            # gemini | openai | anthropic
LLM_API_KEY=
LLM_MODEL=                     # optional override, e.g. gemini-2.5-flash, gpt-4o-mini, claude-haiku-4-5

# --- Optional OWASP ZAP daemon (docker run -p 8090:8090 zaproxy/zap-stable zap.sh -daemon -port 8090 -host 0.0.0.0 -config api.key=KEY -config api.addrs.addr.name=.* -config api.addrs.addr.regex=true)
ZAP_API_URL=
ZAP_API_KEY=
