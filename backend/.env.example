# --- Core ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://vs:vs@localhost:5432/flowforge
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# 32-byte key (base64 or hex) used to encrypt stored workflow credentials with AES-256-GCM.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_KEY=

# --- Execution safety ---
# When false (default/production), workflow HTTP nodes cannot reach private, loopback,
# or cloud-metadata IPs. Only set true for local dev against the bundled mock API.
ALLOW_PRIVATE_EGRESS=false
# Extra hostnames workflow HTTP nodes may call even though they resolve to private IPs
# (used so the demo can call the bundled mock API on localhost). Comma separated host:port.
EGRESS_ALLOWLIST=
MAX_STEPS_PER_RUN=100
STEP_TIMEOUT_MS=15000
MAX_HTTP_RESPONSE_BYTES=1048576
RUN_CONCURRENCY=5
